# Starfield Saver — optional settings
#
# Put this file (renamed to "starfield-saver.ini") in the SAME folder as
# StarfieldSaver.scr, then restart the screensaver. No rebuild needed.
# If that folder isn't writable (e.g. the .scr is in C:\Windows\System32),
# put it in:  %APPDATA%\ssaver\StarfieldSaver\starfield-saver.ini
#
# Lines are  key = value.  '#' or ';' starts a comment. Unknown/missing keys
# fall back to the built-in defaults.

# CRT post-process (curvature, scanlines, glow). 0 = off (default), 1 = on.
crt = 0

# Internal render resolution = native resolution / downscale.
#   1 = crispest (default)   2 = softer/chunkier   3 = chunky retro pixels
downscale = 1

# Audition / eye-review mode. 0 = off (default), 1 = on. When on, the saver
# cycles through every event in order, one at a time, instead of spawning them
# at random — handy for reviewing the visuals. Press N / Right to skip to the
# next event, ESC to quit. Set back to 0 for normal screensaver behaviour.
audition = 0
